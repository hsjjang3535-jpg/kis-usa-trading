# ── KIS (국내 봇과 동일 앱키·계좌 사용 가능) ─────────────────
KIS_MODE=실전
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── HTTP health (Railway) ───────────────────────────────────
PORT=8080
API_SECRET=

# ── US market ───────────────────────────────────────────────
# 거래소: NAS=나스닥, NYS=뉴욕, AMS=아멕스
# 동적 워치: KIS 거래량급증+상승률 순위 → 필터 → TOP N (전수 스캔 아님)
US_DYNAMIC_WATCHLIST=true
US_MAX_WATCHLIST=10
US_MIN_WATCHLIST=1
US_SCREEN_MIN_RATE=2.0
US_SCREEN_MIN_RATE_RELAXED=0.5
US_SCREEN_MIN_SCORE=2.0
US_SCREEN_MIN_SCORE_RELAXED=0.5
US_SCREEN_MIN_PRICE=5.0
US_SCREEN_INTERVAL_MIN=30
# 거래량조건 0=전체 (3=1만주이상이면 개장 직후 풀이 자주 빔)
US_SCREEN_VOL_RANG=0
US_SCREEN_INCLUDE_NYS=true
US_EXCLUDE_MEGA_CAP=true
US_MEGA_CAP_RANK_CUTOFF=50
# 해외 ETP(ETF/ETN/레버리지) 제외 — 일반주만 (ETP 미신청 계좌 실주문 실패 방지)
US_EXCLUDE_ETP=true
# 최후 폴백 (2차 순위까지 실패 시에만)
US_FALLBACK_WATCHLIST=SOFI:NAS,PLTR:NAS,RIVN:NAS,MARA:NAS,COIN:NAS,HOOD:NAS
US_WATCHLIST=AAPL:NAS,MSFT:NAS,NVDA:NAS,TSLA:NAS
US_POLL_INTERVAL_MIN=5
# 보유 중 손절·익절만 (초). 워치 전체 스캔과 분리 — API 부담 적음
US_EXIT_POLL_SEC=60
US_HEARTBEAT_HOUR_KST=22

ENABLE_US_SIM=true
ENABLE_US_S_RULE=true
ENABLE_US_ORB=true
ENABLE_US_GAP_GO=true
US_REQUIRE_ABOVE_VWAP=true
US_GAP_MIN_PCT=2.5
US_GAP_MAX_PCT=15.0
US_GAP_MIN_RVOL=2.0
US_ORB_MINUTES=10
US_ORB_ENTRY_UNTIL_MIN=120
US_ORB_MIN_RVOL=1.5
# 1종목 ≈100만원 (USD 환산, 기본 750)
US_SIM_AMOUNT_USD=750
US_LIVE_AMOUNT_USD=750
# 실전 총 투자 한도 ≈200만원
US_MAX_TOTAL_USD=1500
US_SIM_STOP_LOSS_PCT=2.0
# 왕복 수수료 ~0.5%(매수·매도 각 0.25%) 반영 기본 +6%
US_SIM_TAKE_PROFIT_PCT=6.0
US_FEE_ONE_WAY_PCT=0.25
US_SIM_MIN_DAY_PCT=3.0
US_SIM_MIN_RVOL=2.5
# 방식 A: true면 점수 높은 신호만 실주문 (워밍업·점검당 한도·최소점수)
ENABLE_US_LIVE_ORDERS=false
US_LIVE_MAX_POSITIONS=3
# 개장 후 N분: 시뮬만 (초반 슬롯 소진 방지). ORB 10분이면 약 09:55 ET부터 실전 가능
US_LIVE_WARMUP_MIN=25
# 5분 점검마다 실전 최대 1건 — 같은 스캔의 2·3등은 시뮬
US_LIVE_MAX_PER_CHECK=1
# 실전 최소 신호점수 (GapGo≈300+, ORB≈200+)
US_LIVE_MIN_SCORE=250
# S·RVOL은 실전 슬롯 아끼고 시뮬만
US_LIVE_BLOCK_S=true
# 주포지션 보유 중에도 다른 워치 종목 시뮬 진입·알림
US_PARALLEL_SIM=true
US_MAX_SIM_POSITIONS=5
US_SKIP_NOTIFY_INTERVAL_MIN=120
# 정규장 중간 보고: NY 12:00 이후 세션 중 1회 (창이 아니라 이후 재시도)
US_MID_REPORT_HOUR_NY=12
